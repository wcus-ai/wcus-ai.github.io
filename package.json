{
  "name": "wcus-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "test": "node --test tests/*.test.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.152.0",
    "yaml": "^2.9.1"
  }
}
