{
  "name": "wcus-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node --test --test-concurrency=1 tests/browser/living-block-map.test.ts",
    "verify:map-parity": "node scripts/verify-living-block-map-parity.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "astro": "^6.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.120.0",
    "yaml": "^2.9.0"
  }
}
