---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '@layouts/Base.astro';
import Hero from '@components/Hero.astro';
import ProjectCard from '@components/ProjectCard.astro';
import SiteHeader from '@components/SiteHeader.astro';
import SiteFooter from '@components/SiteFooter.astro';
import ShareFeedback from '@components/ShareFeedback.astro';
import { base } from '@lib/config';

type ProjectEntry = CollectionEntry<'projects'>;

const projects = (await getCollection('projects')).toSorted(
  (a: ProjectEntry, b: ProjectEntry) => a.data.order - b.data.order
);
---

<Base title="WordPress Core AI @ WCUS 2026">
  <a href="#main" class="skip-link">Skip to content</a>
  <Hero />
  <SiteHeader />

  <main id="main">
    <section class="projects" aria-labelledby="projects-heading">
      <div class="projects__heading-block">
        <h2 id="projects-heading">What We're Working On</h2>
        <p class="projects__lead">
          AI moves fast, and so do we. The Core AI Team takes a <a
            href="https://make.wordpress.org/ai/2025/07/17/ai-building-blocks/"
            rel="noopener noreferrer"
            data-track-event="click_outbound"
            data-track-project="site"
            data-track-target="building-blocks-post"
          >building blocks</a> approach, ensuring work stays lean and future-proof for whatever comes next.
        </p>
      </div>
      <div class="project-grid">
        {projects.map((project: ProjectEntry) => <ProjectCard project={project.data} />)}
      </div>
    </section>

    <section class="who" aria-labelledby="who-heading">
      <div class="who__bg" aria-hidden="true"></div>
      <div class="who__inner">
        <div class="who__content">
          <span class="who__eyebrow">Who we are</span>
          <h2 id="who-heading" class="who__title">The WordPress Core AI Team</h2>
          <p class="who__body">
            The booth is an initiative of the WordPress Core AI Team, the working group tasked with bringing AI functionality to WordPress, and staffed by team members, contributors, and community volunteers. Come by and say hello - we'd love to meet you!
          </p>
          <ul class="who__links">
            <li><a
              href="https://make.wordpress.org/ai/"
              rel="noopener noreferrer"
              data-track-event="click_outbound"
              data-track-project="site"
              data-track-target="team-blog"
            >Team blog</a></li>
            <li><a
              href="https://make.wordpress.org/ai/handbook/"
              rel="noopener noreferrer"
              data-track-event="click_outbound"
              data-track-project="site"
              data-track-target="handbook"
            >Handbook</a></li>
          </ul>
        </div>
        <div class="who__image">
          <img
            src={`${base}/images/ai-booth.png`}
            alt="The Core AI Prompt Bar booth graphic — a pixel-art Erlenmeyer flask."
            width="1250"
            height="697"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section class="slack-cta" aria-labelledby="slack-heading">
      <div class="slack-cta__inner">
        <span class="slack-cta__eyebrow">Stay in touch</span>
        <h2 id="slack-heading">Keep the conversation going.</h2>
        <p class="slack-cta__lead">
          The Core AI Team hangs out in the <strong>#core-ai</strong> channel on
          WordPress Slack, holds a weekly contributor call, and runs
          open office hours every other week. Join us to ask questions, share what you're
          building, or follow along with what we're up to.
        </p>
        <div class="slack-cta__actions">
          <a
            class="slack-cta__outline"
            href="https://make.wordpress.org/meetings/#ai"
            rel="noopener noreferrer"
            data-track-event="click_outbound"
            data-track-project="site"
            data-track-target="meetings"
          >
            Upcoming Meetings
          </a>
          <a
            class="slack-cta__primary"
            href="https://wordpress.slack.com/archives/C08TJ8BPULS"
            rel="noopener noreferrer"
            data-track-event="click_outbound"
            data-track-project="site"
            data-track-target="slack"
          >
            Open #core-ai <span aria-hidden="true">→</span>
          </a>
        </div>
        <a
          class="slack-cta__secondary"
          href="https://make.wordpress.org/contribute/join/"
          rel="noopener noreferrer"
          data-track-event="click_outbound"
          data-track-project="site"
          data-track-target="contribute"
        >
          Not on Slack? Join here →
        </a>
      </div>
    </section>

    <ShareFeedback />
  </main>

  <SiteFooter />
</Base>
