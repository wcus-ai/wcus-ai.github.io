---
import { base } from '@lib/config';
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <img
        class="site-footer__logo"
        src={`${base}/images/wcus-2026-white.png`}
        alt="WordCamp US 2026"
        width="48"
        height="48"
        decoding="async"
      />
      <img
        class="site-footer__logo site-footer__logo--wmark"
        src={`${base}/images/wp-wmark-white.png`}
        alt="WordPress"
        width="28"
        height="28"
        decoding="async"
      />
      <a
        class="site-footer__team-link"
        href="https://make.wordpress.org/ai/"
        rel="noopener noreferrer"
        data-track-event="click_outbound"
        data-track-project="site"
        data-track-target="team-blog"
      >
        Core AI Team
      </a>
    </div>
    <p class="site-footer__meta">
      <a
        href="https://us.wordcamp.org/2026/schedule/"
        rel="noopener noreferrer"
        data-track-event="click_outbound"
        data-track-project="site"
        data-track-target="schedule"
      >WCUS 2026 Schedule</a>
      ·
      <a
        href="https://us.wordcamp.org/2026/code-of-conduct/"
        rel="noopener noreferrer"
        data-track-event="click_outbound"
        data-track-project="site"
        data-track-target="code-of-conduct"
      >Code of Conduct</a>
      ·
      <a
        href={`${base}/privacy/`}
        data-track-event="click_internal"
        data-track-project="site"
        data-track-target="privacy"
      >Privacy</a>
    </p>
  </div>
</footer>
