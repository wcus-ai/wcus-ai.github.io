---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <img
        class="site-footer__logo"
        src={`${base}/images/wcus-2026-white.png`}
        alt="WordCamp US 2026"
        width="48"
        height="48"
        decoding="async"
      />
      <img
        class="site-footer__logo site-footer__logo--wmark"
        src={`${base}/images/wp-wmark-white.png`}
        alt="WordPress"
        width="28"
        height="28"
        decoding="async"
      />
      <a
        class="site-footer__team-link"
        href="https://make.wordpress.org/ai/"
        rel="noopener noreferrer"
      >
        Core AI Team
      </a>
    </div>
    <p class="site-footer__meta">
      <a href="https://us.wordcamp.org/2026/schedule/" rel="noopener noreferrer">WCUS 2026 Schedule</a>
      ·
      <a href="https://us.wordcamp.org/2026/code-of-conduct/" rel="noopener noreferrer">Code of Conduct</a>
      ·
      <a href="/privacy/">Privacy</a>
    </p>
  </div>
</footer>
