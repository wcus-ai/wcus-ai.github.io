---
import { base } from '@lib/config';
---

<header class="site-header" id="site-header" data-collapsed="false" inert aria-hidden="true">
  <div class="site-header__inner">
    <a
      class="site-header__brand"
      href={`${base}/`}
      aria-label="Core AI Prompt Bar — home"
      data-track-event="click_internal"
      data-track-project="site"
      data-track-target="home"
    >
      <img
        class="site-header__logo"
        src={`${base}/images/wcus-main.png`}
        alt=""
        width="32"
        height="32"
        decoding="async"
      />
      <span class="site-header__title">Core AI Prompt Bar</span>
    </a>
    <a
      class="site-header__feedback"
      href="#share-feedback"
      data-track-event="click_internal"
      data-track-project="site"
      data-track-target="share-feedback"
    >
      Share Feedback →
    </a>
  </div>
</header>

<script>
  let cleanup: (() => void) | null = null;

  const setup = (): void => {
    if (cleanup) {
      cleanup();
      cleanup = null;
    }

    const header = document.getElementById('site-header');
    const hero = document.getElementById('hero');
    if (!header) return;

    let ticking = false;
    const update = (): void => {
      const heroBottom = hero ? hero.getBoundingClientRect().bottom : -1;
      const visible = heroBottom < 0;
      header.style.transform = visible ? 'translateY(0)' : '';
      header.toggleAttribute('inert', !visible);
      if (visible) {
        header.removeAttribute('aria-hidden');
      } else {
        header.setAttribute('aria-hidden', 'true');
      }
      ticking = false;
    };

    const onScroll = (): void => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();

    cleanup = () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
    };
  };

  // Re-init on every Astro View Transition navigation
  document.addEventListener('astro:page-load', setup);
  // Also run on initial load in case astro:page-load already fired
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup);
  } else {
    setup();
  }
</script>
